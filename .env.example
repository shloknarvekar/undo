# PayPal sandbox REST app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Agent operator: a second sandbox business account with its own REST app. When an agent breaks a mandate and the
# merchant refunds, this account pays the merchant back through Payouts. Optional: without it, liability is
# recorded as unsettled and the merchant console offers a retry.
PAYPAL_OPERATOR_CLIENT_ID=
PAYPAL_OPERATOR_CLIENT_SECRET=

# MCP server: registered agent operators, as Name:key pairs (comma-separated). Optional.
# UNDO_OPERATOR_KEYS=Acme Agents:long-random-key

# Channel3 product data API (trychannel3.com > dashboard > API keys)
CHANNEL3_API_KEY=

# Neon free Postgres — `neon env pull` writes these. App uses the pooled one, migrations the direct one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Gemini API free tier (aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
