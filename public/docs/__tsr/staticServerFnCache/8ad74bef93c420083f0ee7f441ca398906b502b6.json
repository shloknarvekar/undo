cument covers the HTTP API that the web app, agents and merchants call directly.\\n"},{"t":10,"i":6,"p":{"k":["name","url"],"v":[{"t":1,"s":"Undo"},{"t":1,"s":"https://undo-1c56.onrender.com"}]},"o":0},{"t":10,"i":7,"p":{"k":["name","url"],"v":[{"t":1,"s":"MIT"},{"t":1,"s":"https://opensource.org/licenses/MIT"}]},"o":0},{"t":10,"i":8,"p":{"k":["default-environment","default-server","environments"],"v":[{"t":1,"s":"Production"},{"t":1,"s":"Default"},{"t":9,"i":9,"a":[{"t":10,"i":10,"p":{"k":["name","servers","description"],"v":[{"t":1,"s":"Production"},{"t":9,"i":11,"a":[{"t":10,"i":12,"p":{"k":["name","url","description"],"v":[{"t":1,"s":"Default"},{"t":1,"s":"https://undo-1c56.onrender.com"},{"t":1,"s":"Undo's API on Render."}]},"o":0}],"o":0},{"t":1,"s":"The live sandbox deployment. PayPal sandbox only; no real money moves."}]},"o":0}],"o":0}]},"o":0}]},"o":0},{"t":9,"i":13,"a":[{"t":10,"i":14,"p":{"k":["url","description"],"v":[{"t":1,"s":"https://undo-1c56.onrender.com"},{"t":1,"s":"Live sandbox deployment"}]},"o":0}],"o":0},{"t":9,"i":15,"a":[],"o":0},{"t":9,"i":16,"a":[{"t":10,"i":17,"p":{"k":["name","description"],"v":[{"t":1,"s":"Products"},{"t":1,"s":"Live product catalog search and detail, resolved to an exact variant."}]},"o":0},{"t":10,"i":18,"p":{"k":["name","description"],"v":[{"t":1,"s":"Mandates"},{"t":1,"s":"Drafting, preparing, signing and reading shopper-signed intent mandates."}]},"o":0},{"t":10,"i":19,"p":{"k":["name","description"],"v":[{"t":1,"s":"Mandate requests"},{"t":1,"s":"The shopper's side of a mandate an outside agent asked for."}]},"o":0},{"t":10,"i":20,"p":{"k":["name","description"],"v":[{"t":1,"s":"Shopping"},{"t":1,"s":"Let Undo's agent shop inside a mandate and open a PayPal checkout that only authorizes the money."}]},"o":0},{"t":10,"i":21,"p":{"k":["name","description"],"v":[{"t":1,"s":"Orders"},{"t":1,"s":"Purchases, their undo windows, the Undo button, and the evidence to verify them."}]},"o":0},{"t":10,"i":22,"p":{"k":["name